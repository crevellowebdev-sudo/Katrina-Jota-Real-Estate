/** Katrina Jota Real Estate inquiry emails. Deploy separately from the Vite site. */
var INQUIRY_CONFIG = {
  recipient: 'rozelramos17@gmail.com',
  replyTo: 'keysbykatrinaj@gmail.com',
  brand: 'Katrina Jota Real Estate',
  dailyLimit: 30,
  maxBodyLength: 14000,
  statuses: ['Looking to buy', 'Looking to sell', 'Both buying and selling'],
  timelines: ['As soon as possible', 'Within 3 months', 'Within 6 months', 'More than 6 months']
};

function doGet() {
  return jsonResponse_({ ok: false, code: 'POST_REQUIRED' });
}

function doPost(e) {
  var lock;
  try {
    var raw = e && e.postData && e.postData.contents;
    if (!raw || raw.length > INQUIRY_CONFIG.maxBodyLength) {
      return jsonResponse_({ ok: false, code: 'INVALID_REQUEST' });
    }
    var payload;
    try { payload = JSON.parse(raw); }
    catch (parseError) { return jsonResponse_({ ok: false, code: 'INVALID_REQUEST' }); }
    if (!payload || typeof payload !== 'object' || Array.isArray(payload)) {
      return jsonResponse_({ ok: false, code: 'INVALID_REQUEST' });
    }
    var properties = PropertiesService.getScriptProperties();
    var secret = properties.getProperty('INQUIRY_SECRET');
    // The secret belongs in a trusted server/relay, never a VITE_ variable.
    if (!secret || secret.length < 32 || payload.secret !== secret) {
      return jsonResponse_({ ok: false, code: 'UNAUTHORIZED' });
    }
    // Authenticated connection check. Never sends mail or consumes the mail quota.
    if (payload.action === 'check') {
      return jsonResponse_({ ok: true, recipient: INQUIRY_CONFIG.recipient, consentVersion: 'inquiry-consent-v1' });
    }
    if (payload.website !== undefined && (typeof payload.website !== 'string' || payload.website !== '')) return jsonResponse_({ ok: false, code: 'INVALID_REQUEST' });
    var inquiry = validateInquiry_(payload);
    if (!inquiry) return jsonResponse_({ ok: false, code: 'VALIDATION_ERROR' });

    lock = LockService.getScriptLock();
    if (!lock.tryLock(10000)) return jsonResponse_({ ok: false, code: 'BUSY' });

    var now = Date.now();
    var fingerprint = Utilities.base64EncodeWebSafe(Utilities.computeDigest(
      Utilities.DigestAlgorithm.SHA_256, JSON.stringify(inquiry), Utilities.Charset.UTF_8
    ));
    // Bounded ledger of hashes only: no inquiry text or email addresses stored.
    var ledger = JSON.parse(properties.getProperty('INQUIRY_SENDS') || '[]')
      .filter(function (entry) { return entry.at > now - 86400000; });
    var receipt = ledger.filter(function (entry) { return entry.hash === fingerprint; })[0];
    if (receipt && receipt.visitorSent) return jsonResponse_({ ok: true, duplicate: true });
    // Legacy hash-only entries already represent an accepted owner notification.
    var ownerSent = receipt && receipt.ownerSent !== false;
    var requiredQuota = ownerSent ? 1 : 2;
    if ((!receipt && ledger.length >= INQUIRY_CONFIG.dailyLimit) || MailApp.getRemainingDailyQuota() < requiredQuota) {
      return jsonResponse_({ ok: false, code: 'LIMIT_REACHED' });
    }

    // Create the submission timestamp on the server, never from a browser-provided date.
    // Reuse the original receipt timestamp on partial-delivery retries.
    var consent = receipt && receipt.consent ? receipt.consent : {
      inquiryConsent: inquiry.inquiryConsent,
      marketingConsent: inquiry.marketingConsent,
      submittedAt: new Date(now).toISOString()
    };
    inquiry.submittedAt = consent.submittedAt;
    var timestamp = Utilities.formatDate(new Date(consent.submittedAt), 'America/Toronto', 'MMMM d, yyyy, h:mm a z');
    var subject = 'New real estate inquiry | ' + inquiry.fullName;
    var logo = inquiryLogo_();
    if (!ownerSent) MailApp.sendEmail({
      to: INQUIRY_CONFIG.recipient,
      name: INQUIRY_CONFIG.brand,
      replyTo: inquiry.email,
      subject: subject,
      body: renderPlainText_(inquiry, timestamp),
      htmlBody: renderInquiryEmail_(inquiry, timestamp),
      inlineImages: { katrinaLogo: logo }
    });
    if (!receipt) {
      receipt = { hash: fingerprint, at: now, ownerSent: true, visitorSent: false, consent: consent };
      ledger.push(receipt);
    } else { receipt.ownerSent = true; receipt.consent = consent; }
    // Save partial acceptance so a failed visitor email can retry without repeating the owner email.
    properties.setProperty('INQUIRY_SENDS', JSON.stringify(ledger));
    MailApp.sendEmail({
      to: inquiry.email,
      name: INQUIRY_CONFIG.brand,
      replyTo: INQUIRY_CONFIG.replyTo,
      subject: 'Thank you for your inquiry | ' + INQUIRY_CONFIG.brand,
      body: renderVisitorPlainText_(inquiry),
      htmlBody: renderVisitorEmail_(inquiry),
      inlineImages: { katrinaLogo: logo }
    });
    receipt.visitorSent = true;
    properties.setProperty('INQUIRY_SENDS', JSON.stringify(ledger));
    // MailApp accepted the send; this is not confirmation of inbox delivery.
    return jsonResponse_({ ok: true });
  } catch (error) {
    // Do not log submitted personal information or the secret.
    return jsonResponse_({ ok: false, code: 'SEND_FAILED' });
  } finally {
    if (lock && lock.hasLock()) lock.releaseLock();
  }
}

function validateInquiry_(payload) {
  if (!payload || typeof payload !== 'object' || Array.isArray(payload)) return null;
  // Match the relay's independent validation; this deployment can receive direct requests.
  var limits = { fullName: 120, email: 254, phone: 40, status: 80, area: 200, timeline: 80, message: 5000 };
  var values = {};
  for (var key in limits) {
    if (payload[key] !== undefined && typeof payload[key] !== 'string') return null;
    var raw = payload[key] === undefined ? '' : payload[key];
    if (raw.length > limits[key]) return null;
    var controls = key === 'message' ? /[\x00-\x08\x0b\x0c\x0e-\x1f\x7f-\x9f]/ : /[\x00-\x1f\x7f-\x9f\u2028\u2029]/;
    if (controls.test(raw) || /[\uD800-\uDFFF]/u.test(raw)) return null;
    values[key] = raw.replace(/\r\n?/g, '\n').trim();
  }
  if (!values.fullName || !/^[^\s@<>,;]+@[^\s@<>,;]+\.[^\s@<>,;]+$/.test(values.email)) return null;
  // Required Canadian/US phone, matching the frontend and trusted relay.
  if (!/^(?:\+?1[ .-]?)?(?:\([2-9]\d{2}\)|[2-9]\d{2})[ .-]?[2-9]\d{2}[ .-]?\d{4}$/.test(values.phone)) return null;
  if (values.status && INQUIRY_CONFIG.statuses.indexOf(values.status) === -1) return null;
  if (values.timeline && INQUIRY_CONFIG.timelines.indexOf(values.timeline) === -1) return null;
  if (payload.inquiryConsent !== true) return null;
  if (payload.marketingConsent !== undefined && typeof payload.marketingConsent !== 'boolean') return null;
  if (typeof payload.privacyPolicyUrl !== 'string' || payload.privacyPolicyUrl.length > 2048 || !/^https:\/\/[^\s<>"']+$/.test(payload.privacyPolicyUrl)) return null;
  if (payload.consentVersion !== 'inquiry-consent-v1') return null;
  values.inquiryConsent = true;
  values.marketingConsent = payload.marketingConsent === true;
  values.privacyPolicyUrl = payload.privacyPolicyUrl;
  values.consentVersion = 'inquiry-consent-v1';
  return values;
}

function escapeHtml_(value) {
  // Encode only at the HTML output boundary; keep legitimate apostrophes and text intact.
  return String(value).replace(/[&<>"']/g, function (character) {
    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[character];
  });
}

function renderPlainText_(inquiry, timestamp) {
  return INQUIRY_CONFIG.brand + '\nNEW WEBSITE INQUIRY\nReceived: ' + timestamp + '\n\n' +
    'Full name: ' + inquiry.fullName + '\nEmail: ' + inquiry.email +
    '\nPhone: ' + (inquiry.phone || 'Not provided') +
    '\nBuying/selling status: ' + (inquiry.status || 'Not provided') +
    '\nPreferred area: ' + (inquiry.area || 'Not provided') +
    '\nTimeline: ' + (inquiry.timeline || 'Not provided') +
    '\n\nMessage\n' + (inquiry.message || 'No message provided.') +
    '\n\nReply to this email to contact the visitor.\nToronto, GTA, Canada' +
    '\n\nCONTACT PREFERENCES\nPermission to respond: ' + (inquiry.inquiryConsent ? 'Confirmed' : 'Not confirmed') +
    '\nMarketing emails: ' + (inquiry.marketingConsent ? 'Requested' : 'Not requested') +
    '\nPrivacy Policy: ' + inquiry.privacyPolicyUrl +
    '\n\nSubmission record (reference only)\nRecorded at (UTC): ' + (inquiry.submittedAt || '') +
    '\nConsent reference: ' + inquiry.consentVersion;
}

function renderInquiryEmail_(inquiry, timestamp, logoUrl) {
  var safe = escapeHtml_;
  var email = safe(inquiry.email);
  var replyUrl = 'https://mail.google.com/mail/?view=cm&fs=1&to=' + encodeURIComponent(inquiry.email) +
    '&su=' + encodeURIComponent('Re: Your real estate inquiry');
  var logo = renderBrandLogo_(logoUrl);
  var rows = [
    ['Full name', inquiry.fullName],
    ['Email', '<a href="mailto:' + safe(encodeURIComponent(inquiry.email)) + '" style="color:#024D2C;text-decoration:underline;">' + email + '</a>', true],
    ['Phone', inquiry.phone],
    ['Buying/selling status', inquiry.status],
    ['Preferred area', inquiry.area],
    ['Timeline', inquiry.timeline]
  ].map(function (row) {
    return '<tr><td style="padding:16px 0;border-bottom:1px solid #e3e7df;">' +
      '<p style="margin:0 0 6px;color:#59625b;font-size:14px;line-height:1.5;">' + row[0] + '</p>' +
      '<p style="margin:0;color:#242824;font-size:16px;line-height:1.6;overflow-wrap:anywhere;word-break:break-word;">' +
      (row[2] ? row[1] : safe(row[1] || 'Not provided')) + '</p></td></tr>';
  }).join('');
  return '<!doctype html><html lang="en"><head><meta charset="utf-8">' +
    '<meta name="viewport" content="width=device-width,initial-scale=1"><title>New real estate inquiry</title></head>' +
    '<body style="margin:0;padding:0;background:#FAFBF7;color:#242824;">' +
    '<div style="display:none;max-height:0;overflow:hidden;opacity:0;">A new inquiry from ' + safe(inquiry.fullName) + '.</div>' +
    '<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#FAFBF7;font-family:\'DM Sans\',Arial,sans-serif;">' +
    '<tr><td align="center" style="padding:32px 12px;">' +
    '<!--[if mso]><table role="presentation" width="640"><tr><td><![endif]-->' +
    '<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:640px;background:#FFFFFF;">' +
    '<tr><td style="padding:32px 24px;background:#FAFBF7;border-top:3px solid #BF9C61;">' + logo + '</td></tr>' +
    '<tr><td style="padding:36px 24px;background:#024D2C;color:#FFFFFF;">' +
    '<p style="margin:0 0 14px;font-size:13px;line-height:1.5;letter-spacing:2px;font-weight:600;">NEW WEBSITE INQUIRY</p>' +
    '<h1 style="margin:0;color:#FFFFFF;font-family:\'Cormorant Garamond\',Georgia,serif;font-size:36px;font-weight:600;line-height:1.15;">A new conversation<br>starts here.</h1>' +
    '<p style="margin:20px 0 0;color:#FFFFFF;font-size:16px;line-height:1.7;">' + safe(inquiry.fullName) + ' has contacted you through your website.</p></td></tr>' +
    '<tr><td style="padding:32px 24px;">' +
    '<p style="margin:0 0 24px;color:#59625b;font-size:13px;line-height:1.6;">RECEIVED &nbsp; ' + safe(timestamp) + '</p>' +
    '<h2 style="margin:0 0 8px;color:#024D2C;font-family:\'Cormorant Garamond\',Georgia,serif;font-size:32px;line-height:1.2;font-weight:600;">Inquiry details</h2>' +
    '<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="table-layout:fixed;">' + rows + '</table>' +
    '<h2 style="margin:32px 0 16px;color:#024D2C;font-family:\'Cormorant Garamond\',Georgia,serif;font-size:32px;line-height:1.2;font-weight:600;">Message</h2>' +
    '<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="table-layout:fixed;"><tr><td style="padding:20px;background:#FAFBF7;border-left:2px solid #BF9C61;">' +
    '<p style="margin:0;font-size:16px;line-height:1.8;overflow-wrap:anywhere;word-break:break-word;">' + safe(inquiry.message || 'No message provided.').replace(/\r?\n/g, '<br>') + '</p></td></tr></table>' +
    '<table role="presentation" cellpadding="0" cellspacing="0" style="margin-top:28px;"><tr><td bgcolor="#024D2C" style="background:#024D2C;">' +
    '<a target="_blank" href="' + safe(replyUrl) + '" style="display:inline-block;padding:17px 24px;border:1px solid #024D2C;color:#FFFFFF;font-size:16px;font-weight:600;line-height:1.5;text-decoration:none;">Reply to inquiry &rarr;</a></td></tr></table>' +
    '<p style="margin:16px 0 0;color:#59625b;font-size:14px;line-height:1.7;">You can also reply directly to this email to reach the visitor.</p></td></tr>' +
    '<tr><td style="padding:24px;background:#FAFBF7;border-top:1px solid #BF9C61;">' +
    '<p style="margin:0;color:#024D2C;font-size:16px;font-weight:600;line-height:1.6;">Katrina Jota Real Estate</p>' +
    '<p style="margin:6px 0 0;color:#59625b;font-size:14px;line-height:1.7;">Toronto, GTA, Canada<br>' +
    '<a href="tel:+14168875670" style="color:#024D2C;text-decoration:underline;">(416) 887-5670</a></p>' +
    '<p style="margin:20px 0 0;color:#59625b;font-size:12px;line-height:1.7;">This email contains contact information submitted through your website. Please handle it with care.</p>' +
    '<p style="margin:16px 0 4px;color:#242824;font-size:12px;line-height:1.7;font-weight:600;">Contact preferences</p>' +
    '<p style="margin:0;color:#59625b;font-size:12px;line-height:1.7;">' +
    (inquiry.inquiryConsent ? 'The visitor has given permission to respond to this inquiry.' : 'Permission to respond has not been confirmed.') +
    '<br>Marketing emails: ' + (inquiry.marketingConsent ? 'Requested by the visitor.' : 'Not requested.') +
    '<br><a href="' + safe(inquiry.privacyPolicyUrl) + '" style="color:#024D2C;text-decoration:underline;">Privacy Policy</a></p>' +
    '</td></tr></table><!--[if mso]></td></tr></table><![endif]--></td></tr></table></body></html>';
}

function renderBrandLogo_(logoUrl) {
  var source = logoUrl || 'cid:katrinaLogo';
  if (source !== 'cid:katrinaLogo' && !/^https:\/\/[^\s]+$/i.test(source)) return '';
  return '<img src="' + escapeHtml_(source) + '" alt="Katrina Jota Real Estate" width="240" style="display:block;width:240px;max-width:100%;height:auto;border:0;">';
}

function renderVisitorPlainText_(inquiry) {
  return INQUIRY_CONFIG.brand + '\n\nHi ' + inquiry.fullName + ',\n\n' +
    'Thank you for reaching out. Your real estate inquiry has been received.\n\n' +
    'Your selected timeline: ' + (inquiry.timeline || 'Not provided') + '\n\n' +
    'This confirms your inquiry, not an appointment. A consultation date and time will need to be arranged with Katrina.\n\n' +
    'You can reply to this email to continue the conversation.\n' + INQUIRY_CONFIG.replyTo +
    '\n(416) 887-5670\nToronto, GTA, Canada';
}

function renderVisitorEmail_(inquiry, logoUrl) {
  var safe = escapeHtml_;
  return '<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Thank you for your inquiry</title></head>' +
    '<body style="margin:0;background:#FAFBF7;color:#242824;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-family:Arial,sans-serif;background:#FAFBF7;">' +
    '<tr><td align="center" style="padding:32px 12px;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:640px;background:#FFFFFF;">' +
    '<tr><td style="padding:32px 24px;border-top:3px solid #BF9C61;background:#FAFBF7;">' + renderBrandLogo_(logoUrl) + '</td></tr>' +
    '<tr><td style="padding:36px 24px;background:#024D2C;"><h1 style="margin:0;font:600 36px/1.2 Georgia,serif;color:#FFFFFF;">Thank you for<br>reaching out.</h1></td></tr>' +
    '<tr><td style="padding:32px 24px;font-size:16px;line-height:1.8;">' +
    '<p style="margin:0 0 20px;">Hi ' + safe(inquiry.fullName) + ',</p>' +
    '<p style="margin:0 0 24px;">Thank you for reaching out. Your real estate inquiry has been received.</p>' +
    '<p style="margin:0 0 24px;padding:20px;background:#FAFBF7;border-left:2px solid #BF9C61;"><strong>Your selected timeline</strong><br>' + safe(inquiry.timeline || 'Not provided') + '</p>' +
    '<p style="margin:0 0 24px;">This confirms your inquiry, not an appointment. A consultation date and time will need to be arranged with Katrina.</p>' +
    '<p style="margin:0;">You can reply to this email to continue the conversation.</p></td></tr>' +
    '<tr><td style="padding:24px;background:#FAFBF7;border-top:1px solid #BF9C61;font-size:14px;line-height:1.8;">' +
    '<strong style="color:#024D2C;">Katrina Jota Real Estate</strong><br>Toronto, GTA, Canada<br>' +
    '<a href="mailto:' + safe(INQUIRY_CONFIG.replyTo) + '" style="color:#024D2C;">' + safe(INQUIRY_CONFIG.replyTo) + '</a><br>' +
    '<a href="tel:+14168875670" style="color:#024D2C;">(416) 887-5670</a></td></tr></table></td></tr></table></body></html>';
}

function jsonResponse_(result) {
  return ContentService.createTextOutput(JSON.stringify(result)).setMimeType(ContentService.MimeType.JSON);
}

/** Run manually once in the Apps Script editor to authorize MailApp. Sends nothing. */
function authorizeMail() {
  return MailApp.getRemainingDailyQuota();
}

/** Embedded 480px email derivative of public/images/logo.png; avoids remote-image dependencies. */
function inquiryLogo_() {
  return Utilities.newBlob(Utilities.base64Decode(''), 'image/png', 'logo.png');
}
