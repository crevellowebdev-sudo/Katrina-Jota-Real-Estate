# Confirmed production HTTPS origin, e.g. https://your-domain.com (no paths).
# Enables build-time canonical URLs, social-image URLs, structured data and sitemap.
VITE_SITE_URL=
# Client-approved, published HTTPS Privacy Policy URL. Public, also read by the API.
VITE_PRIVACY_POLICY_URL=

# Server-only variables: .env.local for local testing, Vercel settings for deployment.
# Never add a VITE_ prefix to the secret.
# Use the same value (at least 32 random characters) in Apps Script properties.
INQUIRY_SECRET=
# Optional override; the Vercel function already defaults to the supplied deployment.
APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbyNYW7RZ1_eDUVDzsD5KGKi10SsBeoIq4jB2K0tAaLn8B-QKQA3D4tQCODMvNQqxE0jKQ/exec
